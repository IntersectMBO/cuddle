packages:
  .
  example/

tests:True

test-show-details: streaming

program-options
  ghc-options: -Werror

source-repository-package
  type: git
  location: https://github.com/IntersectMBO/antigen.git
  tag: 904fa627b65095ebc128e9e931006fe49e30b991

-- cabal-allow-newer
if impl (ghc >= 9.14)
  allow-newer:
    , aeson:containers
    , aeson:template-haskell
    , boring:base
    , cborg:base
    , cborg:containers
    , indexed-traversable:base
    , indexed-traversable:containers
    , indexed-traversable-instances:base
    , ordered-containers:containers
    , semialign:base
    , semialign:containers
    , these:base
    , tree-diff:base
    , tree-diff:containers
    , uuid-types:template-haskell
